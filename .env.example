# ----- Mẫu biến môi trường cho SBI Smart Agent -----
# Copy file này thành .env rồi điền giá trị thật (KHÔNG commit .env lên git).

# Bắt buộc: API key của Anthropic (Claude). Lấy tại https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tùy chọn: model Claude. Mặc định "claude-sonnet-4-6".
# Đổi sang "claude-haiku-4-5-20251001" để rẻ & nhanh hơn.
SBI_MODEL=claude-sonnet-4-6

# Tùy chọn: tham số sinh văn bản
SBI_MAX_TOKENS=1024
SBI_TEMPERATURE=0.2
SBI_MAX_HISTORY_TURNS=12

# ----- Lead capture (đăng ký tư vấn) -----
# Tùy chọn: URL Google Apps Script Web App để ghi lead vào Google Sheet.
# SBI_LEADS_WEBHOOK_URL=https://script.google.com/macros/s/xxxx/exec

# ----- Trang quản trị /admin -----
# Token bảo vệ /api/admin/*. ĐỂ TRỐNG => trang quản trị bị tắt.
# SBI_ADMIN_TOKEN=doi-thanh-chuoi-bi-mat-cua-ban

# ----- Lưu trữ bền vững (Firestore) -----
# "auto" (mặc định): bật Firestore nếu có project GCP + thư viện; ngược lại dùng file.
# SBI_USE_FIRESTORE=auto
# SBI_FIRESTORE_PROJECT=ten-project-gcp-cua-ban

# Tùy chọn: cổng server (Cloud Run tự cấp PORT=8080)
PORT=8080
