# ----- Mẫu biến môi trường cho SBI Smart Agent -----
# Copy file này thành .env rồi điền giá trị thật (KHÔNG commit .env lên git).

# Bắt buộc: API key của Anthropic (Claude). Lấy tại https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tùy chọn: model Claude. Mặc định "claude-sonnet-4-6".
# Đổi sang "claude-haiku-4-5-20251001" để rẻ & nhanh hơn.
SBI_MODEL=claude-sonnet-4-6

# Tùy chọn: tham số sinh văn bản
SBI_MAX_TOKENS=1024
SBI_TEMPERATURE=0.2
SBI_MAX_HISTORY_TURNS=12

# Tùy chọn: cổng server (Cloud Run tự cấp PORT=8080)
PORT=8080
